# ORION Environment Configuration
# SECURITY: Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy this file to .env and replace every CHANGE_ME_* value.

# --- PostgreSQL ---
POSTGRES_USER=orion_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/keycloak

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- NATS ---
NATS_USER=orion
NATS_PASSWORD=CHANGE_ME_nats_password

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- Security ---
TRUSTED_PROXY_IPS=

# --- AI / Ollama ---
ORION_AI_MODEL=qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
