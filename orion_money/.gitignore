# runtime data (SQLite DB, logs) — keep the .gitkeep placeholder
data/*
!data/.gitkeep

# workspace scratch tree — keep the .gitkeep placeholder (dirs are
# recreated at startup by `python -m orion.cli start`)
workspace/*
!workspace/.gitkeep

# frontend build artifacts
frontend/node_modules/
frontend/dist/

# python
__pycache__/
.venv/
*.pyc

# secrets / local env — keep the .env.example template (parent repo ignores .env.*)
.env
!.env.example