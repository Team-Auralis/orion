# ORION environment configuration.
# Copy to `.env` (never commit `.env`). Most settings live in config/*.yaml;
# only ORION_DATA_DIR, ORION_AUTONOMY_MODE, and ORION_BROWSER_DRIVER override
# YAML values. The other variables here are read directly by code and have
# safe defaults when unset.

# Directory holding the SQLite DB and logs (overrides config/default.yaml paths.data_dir).
ORION_DATA_DIR=data

# Runtime environment: dev | prod (read by orion/log.py; affects log handling).
ORION_ENV=dev

# Set to "true" to disable any Ollama/LLM integration even if it is detected
# (read by orion/router.py). ORION runs fine without a model — DEGRADED.
ORION_FORCE_NO_OLLAMA=false

# Agent autonomy mode (overrides config/default.yaml autonomy.default_mode):
# dry_run | manual | assisted | autonomous.
ORION_AUTONOMY_MODE=dry_run

# Browser driver (overrides config/policies.yaml browser.driver):
# mock (offline fixtures, default) | playwright (real headless research
# browser; requires `pip install playwright && playwright install chromium`).
ORION_BROWSER_DRIVER=mock