# ORION environment configuration.
# Copy to `.env` (never commit `.env`). Any variable may be left unset — the
# system falls back to config/*.yaml values.

# Directory holding the SQLite DB and logs (default: "data").
ORION_DATA_DIR=data

# Runtime environment: dev | prod (default: dev).
ORION_ENV=dev

# Set to "true" to disable any Ollama/LLM integration even if it is detected.
ORION_FORCE_NO_OLLAMA=false

# Browser automation backend: mock | playwright (default: mock).
ORION_BROWSER_DRIVER=mock

# Agent autonomy mode: dry_run | manual | assisted | autonomous (default: dry_run).
ORION_AUTONOMY_MODE=dry_run